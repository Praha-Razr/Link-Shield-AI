# LinkShield AI - Environment Configuration (Template / Example)
# Copy this file to backend/.env and replace placeholders with your actual keys.
# NEVER commit your real .env file to version control.

# Authentication & JWT Security (Change this in production)
SECRET_KEY=your-secret-key-replace-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=120
DEMO_MODE=true

# Seeded Officer Credentials (Demo only, synthetic data)
OFFICER_USERNAME=officer_sharma
OFFICER_PASSWORD=Officer@Shield2026
OFFICER_DISPLAY_NAME=Insp. Rajesh Sharma

ADMIN_USERNAME=admin_cyber
ADMIN_PASSWORD=Admin@Shield2026
ADMIN_DISPLAY_NAME=Admin Cyber Supervisor

# Seeded Citizen Credentials (Demo only, synthetic data)
CITIZEN_USERNAME=citizen_demo
CITIZEN_PASSWORD=Citizen@Shield2026
CITIZEN_DISPLAY_NAME=Demo Citizen

# Optional: Google Gemini API Configuration for Investigation Assistant & Second Opinion
# Add your Google Gemini API key below. Leave empty to run purely in offline Rule-Based mode.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3-flash-preview
AI_ASSIST_ANALYSIS=true

# Privacy Safeguard: Mask phone, UPI, email, and bank account before sending to Gemini for real cases (is_demo=false).
# Set to true only if explicit departmental approval exists to send unmasked real identifiers to external AI.
ALLOW_EXTERNAL_AI_FOR_REAL_CASES=false

# Deployment & Cross-Origin Configuration (Set in production on Render / cloud)
ENVIRONMENT=development
FRONTEND_ORIGINS=http://localhost:5173,https://your-app.vercel.app
AUTO_LOAD_DEMO_DATA=false
# DB_PATH=/var/data/linkshield.db
# SECURE_COOKIES=false

# Optional: Google Safe Browsing Lookup API Key (for real URL reputation checks)
GOOGLE_SAFE_BROWSING_KEY=your-google-safe-browsing-key-here
